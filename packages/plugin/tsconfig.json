{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["./node_modules"]
}
