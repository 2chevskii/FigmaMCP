{
  "name": "figma-mcp-connector",
  "version": "0.2.0",
  "description": "Figma MCP connector",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "npm run compile && npm run bundle",
    "bundle": "node scripts/build.mjs",
    "compile": "tsc",
    "format": "prettier . ../../docs --write",
    "format:check": "prettier . ../../docs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-exclude=tests/** --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=TestResults/coverage/lcov.info tests/*.test.mjs",
    "test:report": "node --test --test-reporter=junit --test-reporter-destination=TestResults/tests/junit.xml tests/*.test.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "author": "2CHEVSKII",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "rolldown": "^1.2.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.57.1"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2"
  }
}
