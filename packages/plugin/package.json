{
  "name": "@2chevskii/figmamcp-bridge-plugin",
  "version": "1.0.0",
  "description": "Figma MCP connector",
  "scripts": {
    "build": "npm run compile && npm run bundle",
    "bundle": "node scripts/build.mjs",
    "compile": "tsc",
    "format": "prettier . ../../docs --write --ignore-path ../../.gitignore",
    "format:check": "prettier . ../../docs --check --ignore-path ../../.gitignore",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "c8 --all --src=src --include=src/**/*.ts --exclude=tests/** --reporter=text --reporter=cobertura --reports-dir=TestResults/coverage node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=TestResults/tests/junit.xml tests/*.test.mjs",
    "watch": "node scripts/build.mjs --watch"
  },
  "author": "2CHEVSKII",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "c8": "^12.0.0",
    "eslint": "^10.9.1",
    "prettier": "^3.8.3",
    "rolldown": "^1.2.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2"
  }
}
