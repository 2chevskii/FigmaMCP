{
  "name": "figma-mcp-connector",
  "version": "0.2.0",
  "description": "Figma MCP connector",
  "main": "dist/plugin.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "prettier . ../docs --write",
    "format:check": "prettier . ../docs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
