    "watch": "node scripts/build.mjs --watch"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "*",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "esbuild": "^0.25.10"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2"
  }
}
